# Your own passcode. The phone asks for it once, the TV app has it in its URL.
APP_PASSCODE=pick-something-long

# Gemini, from aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase, Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel sends this to the morning cron. Any random string.
CRON_SECRET=

# Your timezone and weather location
NEXT_PUBLIC_TZ=Asia/Jerusalem
NEXT_PUBLIC_CITY=Nazareth
NEXT_PUBLIC_LAT=32.70
NEXT_PUBLIC_LON=35.30
